{
  "name": "notion-calendar",
  "productName": "Notion Calendar",
  "desktopName": "notion-calendar.desktop",
  "description": "Electron wrapper for Notion Calendar on Linux: tray (minimize on close), native notifications via notify-send/libnotify with join link actions, window state, and KDE-friendly packaging.",
  "homepage": "https://github.com/opsmachine/notion-calendar-linux",
  "version": "0.2.2",
  "author": {
    "name": "Dušan Simić",
    "email": "dusan.simic1810@gmail.com",
    "url": "https://dusansimic.me"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "start": "env -u ELECTRON_RUN_AS_NODE electron-vite preview",
    "dev": "env -u ELECTRON_RUN_AS_NODE electron-vite dev -- --no-sandbox",
    "prebuild": "electron-vite build",
    "run:electron": "env -u ELECTRON_RUN_AS_NODE ./node_modules/electron/dist/electron . --no-sandbox",
    "build:linux": "npm run prebuild && electron-builder --linux deb --config --publish never"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron-toolkit/utils": "^4.0.0",
    "@swc/core": "^1.15.21",
    "electron": "^42.3.3",
    "electron-builder": "^26.8.1",
    "electron-vite": "^3.0.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "electron-store": "^8.1.0"
  }
}
